{
  "name": "calendario",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "dev:eve": "node --env-file-if-exists=.env.local node_modules/eve/bin/eve.js dev",
    "prebuild": "prisma generate",
    "build": "if [ \"$VERCEL_ENV\" = production ]; then prisma migrate deploy; fi && next build",
    "build:eve": "eve build",
    "start": "next start",
    "start:eve": "eve start",
    "eve:info": "node --env-file-if-exists=.env.local node_modules/eve/bin/eve.js info --json",
    "eval": "CALENDARIO_FAKE_CALENDAR=.eval-calendar.json node --env-file-if-exists=.env.local node_modules/eve/bin/eve.js eval",
    "lint": "eslint",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:e2e": "env -u NO_COLOR playwright test",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@chat-adapter/state-memory": "^4.40.0",
    "@internationalized/date": "^3.12.3",
    "@kapso/chat-adapter": "^0.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "ai": "7.0.58",
    "better-auth": "^1.6.29",
    "chat": "^4.40.0",
    "eve": "0.36.0",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.2.8",
    "rrule": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
