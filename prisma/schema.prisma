generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String               @id
  name          String
  email         String
  emailVerified Boolean              @default(false)
  image         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  sessions      Session[]
  accounts      Account[]
  libraryItems  LibraryItem[]
  libraryTags   LibraryTag[]
  whatsAppLink  WhatsAppLink?
  whatsAppCode  WhatsAppPairingCode?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model LibraryItem {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  description        String
  /// A one-page read of the source, written at save time by the agent.
  /// Optional: manual entries and items saved before the reading view have none.
  summary            String?
  link               String?
  /// Stable identity for attachment-derived entries so workflow retries do not duplicate them.
  attachmentIdentity String?
  tags               LibraryItemTag[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([userId, link])
  @@unique([userId, attachmentIdentity])
  @@unique([id, userId])
  @@index([userId, createdAt])
  @@map("library_item")
}

model LibraryTag {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  items          LibraryItemTag[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, normalizedName])
  @@unique([id, userId])
  @@index([userId, createdAt])
  @@map("library_tag")
}

model LibraryItemTag {
  userId String
  itemId String
  tagId  String
  item   LibraryItem @relation(fields: [itemId, userId], references: [id, userId], onDelete: Cascade)
  tag    LibraryTag  @relation(fields: [tagId, userId], references: [id, userId], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId, userId])
  @@map("library_item_tag")
}

/// Eve does not enforce session ownership, so the channel checks this table on
/// every /eve/v1/session/<id> request. No foreign key: the synthetic local-dev
/// principal has no User row.
model EveSessionOwner {
  sessionId String   @id
  userId    String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("eve_session_owner")
}

/// Binds a WhatsApp identity to an account after pairing from the web app.
model WhatsAppLink {
  waId      String   @id
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("whatsapp_link")
}

/// A short-lived code proving control of both the web account and phone.
model WhatsAppPairingCode {
  code      String   @id
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("whatsapp_pairing_code")
}
