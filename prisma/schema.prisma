generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String               @id
  name          String
  email         String
  emailVerified Boolean              @default(false)
  image         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  sessions      Session[]
  accounts      Account[]
  libraryItems  LibraryItem[]
  libraryTags   LibraryTag[]
  reminders     Reminder[]
  whatsAppLink  WhatsAppLink?
  whatsAppCode  WhatsAppPairingCode?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model LibraryItem {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  description        String
  /// Useful source text, a synthesized read, or a user-authored note.
  note               String?
  link               String?
  /// Stable identity for agent-created unlinked entries so workflow retries do not duplicate them.
  unlinkedIdentity   String?
  tags               LibraryItemTag[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([userId, link])
  @@unique([userId, unlinkedIdentity])
  @@unique([id, userId])
  @@index([userId, createdAt])
  @@map("library_item")
}

model LibraryTag {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  items          LibraryItemTag[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, normalizedName])
  @@unique([id, userId])
  @@index([userId, createdAt])
  @@map("library_tag")
}

model LibraryItemTag {
  userId String
  itemId String
  tagId  String
  item   LibraryItem @relation(fields: [itemId, userId], references: [id, userId], onDelete: Cascade)
  tag    LibraryTag  @relation(fields: [tagId, userId], references: [id, userId], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId, userId])
  @@map("library_item_tag")
}

/// A one-off nudge the agent texts back at `remindAt`. The dispatcher claims a
/// row by taking a short lease, so two overlapping ticks cannot both send it.
model Reminder {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// What to say, already phrased by the agent in the user's own language.
  body        String
  remindAt    DateTime
  /// The IANA zone it was resolved in, so it reads back in local time.
  timeZone    String
  deliveredAt DateTime?
  /// Held while a send is in flight. An expired lease is retried.
  leaseUntil  DateTime?
  /// Identifies the dispatcher tick holding the lease, so a claim can read back
  /// exactly the rows it won.
  leaseToken  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, remindAt])
  @@index([deliveredAt, remindAt])
  @@index([leaseToken])
  @@map("reminder")
}

/// Eve does not enforce session ownership, so the channel checks this table on
/// every /eve/v1/session/<id> request. No foreign key: the synthetic local-dev
/// principal has no User row.
model EveSessionOwner {
  sessionId String   @id
  userId    String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("eve_session_owner")
}

/// Binds a WhatsApp identity to an account after pairing from the web app.
model WhatsAppLink {
  waId      String   @id
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("whatsapp_link")
}

/// A short-lived code proving control of both the web account and phone.
model WhatsAppPairingCode {
  code      String   @id
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("whatsapp_pairing_code")
}

/// One inbound WhatsApp message still waiting to be acknowledged. Eve only
/// persists the Chat SDK thread when it creates the session, so the thread the
/// agent replies through keeps naming the message that opened the
/// conversation; reactions read their targets from here instead. A turn is
/// told about the messages it can tick, and its reply retires the whole batch.
model WhatsAppInboundMessage {
  id         String    @id @default(cuid())
  threadId   String
  messageId  String
  /// A short excerpt, so the agent can tell the numbered messages apart.
  preview    String
  receivedAt DateTime  @default(now())
  /// Set when a turn was shown this message, which is also what makes it a
  /// target that turn's reply may tick.
  shownAt    DateTime?

  @@unique([threadId, messageId])
  @@index([threadId, receivedAt])
  @@map("whatsapp_inbound_message")
}
